---
import { SOCIALS } from "@/consts";
---

<section id="Contact" class="container mx-auto my-28 p-10 space-y-12">
    <h2 class="heading text-5xl lg:text-6xl uppercase">Get in Touch</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 items-center gap-8">
        <div class="space-y-6">
            <p class="text-xl lg:text-3xl max-w-xl">
                Have a project, an idea, or a challenge at hand? Let's collaborate!
            </p>

            <div class="text-xl space-y-2">
                {
                    SOCIALS.map((link) => (
                        <p>
                            <a
                                href={link.HREF}
                                target="_blank"
                                class="underline hover:text-secondary transition"
                            >
                                {link.NAME}
                            </a>
                        </p>
                    ))
                }
            </div>
        </div>
    </div>
</section>
