---
import "@/styles/global.css";
import { Font } from "astro:assets";

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = "/placeholder.png" } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Import base URL -->
<base href={import.meta.env.BASE_URL} />

<!-- fonts -->
<link
    rel="preload"
    href="/fonts/g1_woff2/OCHighwayVAR2-Series5G-1.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link
    rel="preload"
    href="/fonts/og_woff2/OCHighwayVAR2-Series3.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<Font cssVariable="--font-plex" preload />
<Font cssVariable="--font-geist" preload />
