---
import { SITE } from "@/consts";
---

<section class="container mx-auto flex min-h-screen items-center p-6">
    <div class="grid w-full grid-cols-1 gap-8 md:gap-16 lg:grid-cols-2 lg:grid-rows-[auto_auto]">
        <div class="lg:row-start-1">
            <h1 class="heading text-[clamp(3rem,10vw,12.5rem)] uppercase m-0">
                {SITE.TITLE}
            </h1>
        </div>
        <div class="lg:row-start-2 lg:col-start-1">
            <p class="mt-0 text-2xl text-secondary">
                M.A. Education, B.Sc Psychology | Social Impact, Values-driven, Equity-focused
            </p>
        </div>
        <div class="lg:row-start-1 lg:col-start-2 lg:pt-16">
            <p class="text-2xl text-secondary items-center">
                {SITE.DESCRIPTION}
            </p>
        </div>
        <div class="flex flex-col gap-2.5 self-start md:flex-row lg:row-start-2 lg:col-start-2">
            <a
                class="flex shrink-0 items-center justify-center rounded-2xl bg-primary px-6 py-3 sm:w-auto sm:px-10 sm:py-4 cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition"
                href="/projects">View Work</a
            >
            <a
                class="flex shrink-0 items-center justify-center rounded-2xl bg-foreground px-6 py-3 sm:w-auto sm:px-10 sm:py-4 text-background cursor-pointer hover:bg-background hover:outline hover:outline-1 hover:outline-dashed hover:outline-secondary hover:text-foreground transition"
                href="#Contact">Hire me</a
            >
        </div>
    </div>
</section>
